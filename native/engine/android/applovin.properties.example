# AppLovin MAX keys. Copy to applovin.properties (same folder, NOT in git) and fill in.
# AppLovin dashboard > Account > Keys: SDK key. MAX > Ad Units: one unit per format for
# everything.fits.packing.puzzle.organize (Android). Empty sdkKey = simulated "TEST AD" screens.
sdkKey=
bannerUnit=
interUnit=
rewardedUnit=
# AdMob app id (ca-app-pub-…~…): turns on the AdMob network in MAX mediation
admobAppId=
# advertising ids of test phones, comma separated (or register them in MAX > Test Mode). A device or
# debug build prints this phone's id in logcat: "advertising id (testDevices)"
testDevices=
# true = ads switched off for testing (no banner / interstitial, SDK not started)
adsOff=
